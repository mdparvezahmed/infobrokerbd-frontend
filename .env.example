# The InfoBrokerBD backend (Fastify API). On Vercel: the backend project's URL, e.g. https://infobrokerbd-api.vercel.app
API_URL=http://localhost:4000
# Shared secret — must be the SAME value as PROXY_SECRET in the backend
PROXY_SECRET=""
# Map tiles. Default: OpenStreetMap standard tiles (free, attribution required, moderate traffic only).
# For production scale use a tile provider (MapTiler, Stadia, Thunderforest…) or self-host tiles:
# NEXT_PUBLIC_MAP_TILE_URL=https://api.maptiler.com/maps/streets-v2/{z}/{x}/{y}.png?key=YOUR_KEY
# NEXT_PUBLIC_MAP_ATTRIBUTION=&copy; MapTiler &copy; OpenStreetMap contributors
# Public address of the site, used for canonical URLs, the sitemap and structured data (no trailing slash).
# Baked in at BUILD time (like every NEXT_PUBLIC_ variable): set it before `next build`, and redeploy after
# changing it. On Vercel it falls back to the production domain automatically; set it once you have your own domain.
NEXT_PUBLIC_SITE_URL=https://infobrokerbd.com
# Ownership tokens from Google Search Console and Bing Webmaster Tools ("HTML tag" method, content value only)
# GOOGLE_SITE_VERIFICATION=
# BING_SITE_VERIFICATION=
